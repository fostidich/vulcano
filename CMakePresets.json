    {
        "version": 3,
        "cmakeMinimumRequired": {
            "major": 3,
            "minor": 21
        },
        "configurePresets": [
            {
                "name": "default",
                "displayName": "Default Build",
                "binaryDir": "${sourceDir}/build",
                "cacheVariables": {
                    "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                    "CMAKE_OSX_SYSROOT": "macosx"
                }
            },
            {
                "name": "debug",
                "displayName": "Debug Build",
                "inherits": "default",
                "cacheVariables": {
                    "DEBUG": "1"
                }
            }
        ],
        "buildPresets": [
            {
                "name": "default",
                "configurePreset": "default"
            },
            {
                "name": "debug",
                "configurePreset": "debug"
            }
        ]
    }
